#!/bin/zsh
# terminals-core — enumerate live terminal sessions and focus one, for the
# menu-bar ledger. The single door the fork's "Terminals" section uses, the way
# sheol-core is the single door for tmux.
#
#   terminals-core list          one line per session, \x1f-delimited:
#                                id US tty US name US isTmux
#   terminals-core list --json   the same as a JSON array {id,tty,name,isTmux}
#   terminals-core focus <id>    raise that session (iTerm: its window; other
#                                apps: activate the app)
#
# iTerm2 sessions come through its scripting API (stable per-session id + tty +
# name, and pure-`select` window raise — no System Events grant needed). Any
# OTHER terminal app is found generically by scanning ptys (a tty with a login
# shell whose ancestor is a .app that ISN'T iTerm and ISN'T tmux); those get
# id="app:<Name>" and focus just activates the app. tmux is deliberately
# excluded here — attached sessions are its clients (own list), pane shells live
# inside the server — so the terminal list stays non-tmux and can't double-count.
#
# PERF (why the maps below): this runs on the fork's background poll AND on every
# menu open, so it must stay fork-light. Two things used to spawn a subprocess
# PER ROW: a `grep` membership test per tty, and `owning_app` forking `ps` once
# per ancestry level (up to 20). Both are now answered from in-memory maps built
# from a SINGLE `ps` snapshot + the one tmux read — ~20 forks/call down to ~1.
# Output is byte-identical to the fork-per-row version (verified vs golden).
#
# Never launches iTerm: the enumeration is gated on `application … is running`.
set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
[[ "${LC_ALL:-${LANG:-}}" == *[Uu][Tt][Ff]* ]] || export LC_ALL="en_US.UTF-8"

US=$'\x1f'

json_escape() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}; s=${s//$'\n'/\\n}
  print -rn -- "$s"
}

# tmux ttys to keep OUT of the plain-terminal list: pane shells + attached
# clients (the real terminals running `tmux attach`, which belong to tmux).
tmux_ttys() {
  command -v tmux >/dev/null 2>&1 || return 0
  { tmux list-panes -a -F '#{pane_tty}' 2>/dev/null
    tmux list-clients -F '#{client_tty}' 2>/dev/null ; } | sort -u
}

# ---- ONE ps snapshot builds BOTH the ancestry map (pid → ppid, comm) AND the
# login-shell candidate list, from the SAME rows. Deriving them together closes
# the gap where a shell spawned between two separate snapshots would appear in
# the candidate list but not the map (so owning_app would silently drop it).
# comm is the whole rest-of-line so app paths with spaces ("Google Chrome.app/…")
# survive intact; the shell test mirrors the old awk's first-field ($3) match
# exactly — ${_cm%% *} is that first whitespace-delimited token.
typeset -gA _PPID _COMM _TTYCOMMS
_candidates=()          # each: "tty pid" for a login shell on a real tty
while read -r _p _pp _tt _cm; do
  [[ -z "$_p" ]] && continue
  _PPID[$_p]=$_pp
  _COMM[$_p]=$_cm
  # tty → all commands on it, so agent detection sees the WHOLE session tree, not
  # just the foreground job. Catches e.g. claude running under `caffeinate` or
  # behind a sourcekit-lsp/node foreground (jobName alone would miss it).
  if [[ "$_tt" == ttys* ]]; then
    _TTYCOMMS[$_tt]="${_TTYCOMMS[$_tt]:-} ${_cm:t}"
    [[ "${_cm%% *}" == (*-zsh|*-bash|*/zsh|*/bash|*/fish) ]] && _candidates+=("$_tt $_p")
  fi
done < <(ps -Ao pid=,ppid=,tty=,comm=)

# Walk a pid's ancestry to the owning .app; print its name (e.g. "Ghostty").
# Reads the in-memory map — same result as forking `ps` up the tree.
owning_app() {
  local pid=$1 comm guard=0
  while [[ -n "$pid" && "$pid" != 0 && "$pid" != 1 && guard -lt 20 ]]; do
    comm=${_COMM[$pid]:-}
    [[ -z "$comm" ]] && return 1
    if [[ "$comm" == *.app/Contents/MacOS/* ]]; then
      local app="${comm%%.app/*}"
      print -r -- "${app:t}"
      return 0
    fi
    pid=${_PPID[$pid]:-}
    (( guard++ ))
  done
  return 1
}

emit=()  # each element: id US tty US name US isTmux

# tmux ttys as an in-memory set (full "/dev/ttysNNN" keys), so the per-row
# membership test is a hash lookup, not a `grep` subprocess per tty.
typeset -A _TMUXTTY
tclients="$(tmux_ttys)"
while IFS= read -r _t; do
  [[ -n "$_t" ]] && _TMUXTTY[$_t]=1
done <<< "$tclients"

# ---- iTerm sessions ----
# Also grab jobName (the session's FOREGROUND command) so the menu-bar ledger can
# flag agent CLIs (claude/codex/…) before you close a session that's running one.
iterm_ttys=()
iterm_lines=$(/usr/bin/osascript <<OSA
if application "iTerm2" is running then
  tell application "iTerm2"
    set out to ""
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          set jn to ""
          try
            set jn to (variable s named "jobName")
          end try
          set out to out & (id of s) & "$US" & (tty of s) & "$US" & (name of s) & "$US" & jn & linefeed
        end repeat
      end repeat
    end repeat
    return out
  end tell
else
  return ""
end if
OSA
)
if [[ -n "$iterm_lines" ]]; then
  while IFS="$US" read -r id tty name job; do
    [[ -z "$id" ]] && continue
    iterm_ttys+="$tty"
    isTmux=false
    [[ "$name" == tmux* ]] && isTmux=true
    [[ -n "${_TMUXTTY[$tty]:-}" ]] && isTmux=true
    procs="${_TTYCOMMS[${tty#/dev/}]:-}"          # every command on this tty (deep agent detection)
    emit+="${id}${US}${tty}${US}${name}${US}${isTmux}${US}${job}${US}${procs}"
  done <<< "$iterm_lines"
fi

# ---- other terminal apps (generic pty scan) ----
# ttys running a login shell (from the single snapshot above), minus iTerm's and
# tmux's, grouped to their app. Candidate order is ps order, same as before.
seen_app=()
for _cand in "${_candidates[@]}"; do
  tty="${_cand%% *}"                                              # "ttysNNN"
  pid="${_cand##* }"
  dev="/dev/$tty"
  [[ -n "${_TMUXTTY[$dev]:-}" ]] && continue                      # tmux tty
  (( ${iterm_ttys[(I)$dev]} )) && continue                        # iTerm tty
  app=$(owning_app "$pid") || continue
  [[ "$app" == iTerm* ]] && continue
  (( ${seen_app[(I)$app]} )) && continue                          # one row per app
  seen_app+="$app"
  emit+="app:${app}${US}${dev}${US}${app}${US}false${US}${US}"   # empty job + empty procs (no ✕ on app rows)
done

verb="${1:-}"
case "$verb" in
  list)
    if [[ "${2:-}" == "--json" ]]; then
      print -n '['
      first=1
      for row in "${emit[@]}"; do
        IFS="$US" read -r id tty name isTmux job procs <<< "$row"
        (( first )) || print -n ','
        first=0
        print -rn -- "{\"id\":\"$(json_escape "$id")\",\"tty\":\"$(json_escape "$tty")\",\"name\":\"$(json_escape "$name")\",\"isTmux\":${isTmux},\"job\":\"$(json_escape "$job")\",\"procs\":\"$(json_escape "$procs")\"}"
      done
      print ']'
    else
      for row in "${emit[@]}"; do print -r -- "$row"; done
    fi
    exit 0
    ;;
  focus)
    id="${2:-}"
    [[ -z "$id" ]] && exit 0
    if [[ "$id" == app:* ]]; then
      /usr/bin/open -a "${id#app:}" 2>/dev/null
      exit 0
    fi
    # iTerm session id — pure iTerm select raises its window (no System Events).
    /usr/bin/osascript - "$id" <<'OSA'
on run argv
  set theID to (item 1 of argv)
  if not (application "iTerm2" is running) then return
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is theID then
            select s
            select t
            select w
          end if
        end repeat
      end repeat
    end repeat
    activate
  end tell
end run
OSA
    exit 0
    ;;
  kill)
    # Close a terminal session. Only iTerm sessions can be targeted precisely (by
    # id); an "app:<Name>" row isn't a single session we can address, so it's a
    # deliberate no-op (the menu-bar ledger only offers ✕ on iTerm rows). iTerm's
    # own "a process is running" prompt may still appear — that's fine, it's a
    # second guard on top of the ledger's triple-tap ward.
    id="${2:-}"
    [[ -z "$id" ]] && exit 0
    [[ "$id" == app:* ]] && exit 0
    /usr/bin/osascript - "$id" <<'OSA'
on run argv
  set theID to (item 1 of argv)
  if not (application "iTerm2" is running) then return
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is theID then close s
        end repeat
      end repeat
    end repeat
  end tell
end run
OSA
    exit 0
    ;;
  new)
    # Open a fresh iTerm2 window (the menu-bar "＋ New terminal window"). iTerm is
    # the setup's terminal. ITERM_NO_ACTIVATE=1 opens it in the BACKGROUND without
    # stealing focus — so the menu-bar ledger stays open and you can spawn several.
    /usr/bin/osascript <<'OSA' >/dev/null 2>&1
tell application "iTerm2"
  create window with default profile
  if (system attribute "ITERM_NO_ACTIVATE") is not "1" then activate
end tell
OSA
    exit 0
    ;;
  *)
    print -u2 "terminals-core: list [--json] | focus <id> | kill <id> | new"
    exit 0
    ;;
esac
