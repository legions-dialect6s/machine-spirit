#!/bin/zsh
# sheol-core — primitive verbs over tmux for sheol's operations. The single
# source of truth shared by the TUI (bin/tmux-sheol.sh) and MachineSpirit.app.
#
#   sheol-core list          one line per session, \x1f-delimited:
#                            name US attached US created US activity US command
#                            (byte-identical to what the TUI's load() parses)
#   sheol-core list --json   the same data as a JSON array
#   sheol-core revive <name> reattach the spirit in a NEW iTerm window
#   sheol-core detach <name> pop its clients (living -> sheol)
#   sheol-core kill <name>   end it forever (dead -> exile)
#
# Policy-free by design: the living→sheol / dead→exile two-tier decision and
# the triple-tap ward stay in the callers. This core only does verbs.
#
# Safety: never raises dialogs; exits 0 on expected-empty paths (no tmux, no
# server, no such session); inherits TMUX_TMPDIR from the environment so
# tests isolate for free — revive forwards it into the new window's attach.

set -u

# GUI callers (MachineSpirit.app, the fork's menu-bar tmux item) are spawned by
# launchd with neither Homebrew on PATH nor a UTF-8 locale. Without the former
# `tmux` isn't found; without the latter zsh's `IFS=$'\x1f' read` won't split
# the field stream (every row collapses into one field, so counts read 0). Make
# the core self-sufficient so the TUI, app, and fork can never disagree.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
[[ "${LC_ALL:-${LANG:-}}" == *[Uu][Tt][Ff]* ]] || export LC_ALL="en_US.UTF-8"

US=$'\x1f'
FMT="#{session_name}${US}#{session_attached}${US}#{session_created}${US}#{session_activity}${US}#{pane_current_command}"
HERE="${0:A:h}"

# tmux-resurrect/continuum (cloned to ~/.tmux/plugins by install.sh). save/restore
# go through resurrect's OWN scripts so sheol's snapshots are byte-compatible with
# what continuum auto-saves every 15 min — sheol just triggers them.
RESURRECT="$HOME/.tmux/plugins/tmux-resurrect"

have_tmux() { command -v tmux >/dev/null 2>&1 }

# Where resurrect writes snapshots — mirror its own resolution (option, else the
# classic dir if present, else XDG) so "last save" reads the same file it wrote.
resurrect_dir() {
  local d; d=$(tmux show-option -gqv @resurrect-dir 2>/dev/null)
  [[ -n "$d" ]] && { print -r -- "$d"; return }
  [[ -d "$HOME/.tmux/resurrect" ]] && { print -r -- "$HOME/.tmux/resurrect"; return }
  print -r -- "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
}

json_escape() {   # escaped result returned in $REPLY — avoids a $(…) subshell per field
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  s=${s//$'\n'/\\n}
  REPLY=$s
}

verb="${1:-}"
case "$verb" in
  list)
    have_tmux || exit 0
    if [[ "${2:-}" == "--json" ]]; then
      print -n '['
      tmux list-sessions -F "$FMT" 2>/dev/null | {
        first=1
        while IFS="$US" read -r name attached created activity command; do
          [[ -z "$name" ]] && continue
          [[ "$attached" == <-> ]] || attached=0
          [[ "$created" == <-> ]] || created=0
          [[ "$activity" == <-> ]] || activity=0
          (( first )) || print -n ','
          first=0
          json_escape "$name";          jname=$REPLY
          json_escape "${command:-?}";  jcmd=$REPLY
          print -rn -- "{\"name\":\"$jname\",\"attached\":${attached},\"created\":${created},\"activity\":${activity},\"command\":\"$jcmd\"}"
        done
      }
      print ']'
    else
      tmux list-sessions -F "$FMT" 2>/dev/null
    fi
    exit 0
    ;;
  revive)
    name="${2:-}"
    [[ -z "$name" ]] && exit 0
    have_tmux || exit 0
    tmux has-session -t "=$name" 2>/dev/null || exit 0
    # A GUI can't host `tmux attach` inline — a fresh body means a new window.
    # Hand iTerm tmux's ABSOLUTE path: the new window runs its command in a
    # NON-login shell whose PATH lacks Homebrew, so a bare `tmux` would exit 127
    # ("not found") and the window would vanish after ~1s. env-forward
    # TMUX_TMPDIR so an isolated-socket test revives on the same socket.
    tmux_bin=$(command -v tmux)
    if [[ -n "${TMUX_TMPDIR:-}" ]]; then
      "$HERE/iterm-new-window.sh" env TMUX_TMPDIR="$TMUX_TMPDIR" "$tmux_bin" attach -t "$name"
    else
      "$HERE/iterm-new-window.sh" "$tmux_bin" attach -t "$name"
    fi
    exit 0
    ;;
  detach)
    name="${2:-}"
    [[ -z "$name" ]] && exit 0
    have_tmux || exit 0
    tmux detach-client -s "=$name" 2>/dev/null
    exit 0
    ;;
  kill)
    name="${2:-}"
    [[ -z "$name" ]] && exit 0
    have_tmux || exit 0
    tmux kill-session -t "=$name" 2>/dev/null
    exit 0
    ;;
  save)
    # Snapshot the whole server to disk (same store continuum uses). Idempotent,
    # never destructive — the safety net you take before you do anything risky.
    have_tmux || exit 0
    [[ -x "$RESURRECT/scripts/save.sh" ]] || { print -u2 "sheol-core: tmux-resurrect not installed"; exit 0 }
    tmux list-sessions >/dev/null 2>&1 || exit 0   # empty/no server → don't overwrite a good snapshot with nothing
    "$RESURRECT/scripts/save.sh" >/dev/null 2>&1
    exit 0
    ;;
  restore)
    # Recreate sessions from the last snapshot. resurrect SKIPS sessions that
    # already exist, so this only ever brings back what's missing — safe to run
    # even while other spirits are alive.
    #
    # MUST go through `tmux run-shell`, not a direct call: resurrect spawns the
    # sessions through the tmux SERVER and needs that context — invoked directly
    # it resolves no socket and dies with "error creating". run-shell is exactly
    # how resurrect's own prefix+Ctrl-r binding runs it. start-server first so a
    # restore works even from a cold machine (no server yet after a death).
    have_tmux || exit 0
    [[ -x "$RESURRECT/scripts/restore.sh" ]] || { print -u2 "sheol-core: tmux-resurrect not installed"; exit 0 }
    # run-shell needs a live server, and an EMPTY server self-exits (exit-empty),
    # so from cold: seed a throwaway session, restore into it, then drop the seed
    # once the snapshot's own sessions are back. run-shell is synchronous, so the
    # count is accurate the instant it returns.
    seeded=
    if ! tmux list-sessions >/dev/null 2>&1; then
      tmux new-session -d -s __sheol_seed__ 2>/dev/null && seeded=1
    fi
    tmux run-shell "$RESURRECT/scripts/restore.sh" 2>/dev/null
    if [[ -n "$seeded" ]]; then
      others=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -vcx '__sheol_seed__')
      (( others > 0 )) && tmux kill-session -t '=__sheol_seed__' 2>/dev/null
    fi
    exit 0
    ;;
  kill-all)
    # Banish ALL spirits. SAVE FIRST (so even the nuke is recoverable via
    # `restore`), THEN kill the server — which takes every session with it.
    have_tmux || exit 0
    [[ -x "$RESURRECT/scripts/save.sh" ]] && "$RESURRECT/scripts/save.sh" >/dev/null 2>&1
    tmux kill-server 2>/dev/null
    exit 0
    ;;
  last-save)
    # Epoch mtime of the most recent snapshot, or "0" if none — for the UI's
    # "last saved Nm ago" line. Never touches the server.
    last="$(resurrect_dir)/last"
    if [[ -e "$last" ]]; then
      /usr/bin/stat -f %m "$last" 2>/dev/null || echo 0
    else
      echo 0
    fi
    exit 0
    ;;
  *)
    print -u2 "sheol-core: list [--json] | revive <name> | detach <name> | kill <name> | save | restore | kill-all | last-save"
    exit 0
    ;;
esac
